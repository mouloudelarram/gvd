# ============================================================================
# GVD — root environment file for Docker Compose
# ============================================================================
# Copy this file to `.env` and fill in real values, then run:
#     docker compose up --build
# Docker Compose automatically loads this root `.env` for ${VAR} interpolation
# in docker-compose.yml. This file is a SECRET-FREE template and is committed;
# your real `.env` is gitignored.
# ============================================================================

# --- GitHub OAuth App (https://github.com/settings/developers) ---
# Authorization callback URL must match OAUTH_REDIRECT_URI below.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Flask session signing key ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=change_me_generate_a_32_byte_random_value

# --- OAuth callback (defaults to localhost for local dev) ---
OAUTH_REDIRECT_URI=http://localhost:5000/callback

# --- Enterprise network (optional) ---
# Enable only when a Windows PAC sends GitHub DIRECT while HTTP(S)_PROXY differ.
GITHUB_FOLLOW_WINDOWS_PAC=false

# --- Observability (optional) ---
# LOG_FORMAT: `json` for structured logs (recommended in production) or leave
# unset/`text` for human-readable dev logs. Production is auto-detected when
# ENVIRONMENT=production. All logs are credential-redacted.
LOG_FORMAT=text
# LOG_LEVEL: DEBUG, INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO
# Prometheus metrics are exposed at GET /metrics (keep it on an internal network
# in production; scrape depth/duration/findings/queue gauges from there).
