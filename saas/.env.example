# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here_change_in_production

# Flask Environment (development or production)
FLASK_ENV=development

# OAuth Callback URL (update for your deployment)
OAUTH_REDIRECT_URI=http://localhost:5000/callback

# Enterprise network: enable only when the Windows PAC sends GitHub DIRECT
# while HTTP_PROXY/HTTPS_PROXY contain a different or obsolete proxy.
GITHUB_FOLLOW_WINDOWS_PAC=false

# Optional: Enable/disable features
ENABLE_BULK_SCAN=true
SCAN_TIMEOUT_SECONDS=300
MAX_REPOS_FETCH=1000

