# GVD CLI Scanner - Production Multi-Stage Build
# Designed for background scanning and report generation
# ====================================================

# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    git \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pyproject.toml .

# Create wheels for all dependencies
RUN pip install --no-cache-dir --user \
    --no-warn-script-location \
    build setuptools wheel && \
    pip install --no-cache-dir --user \
    --no-warn-script-location \
    -e .


# Stage 2: Runtime
FROM python:3.11-slim

# Set security umask
RUN umask 0027

# Install runtime dependencies (includes git and other scanning tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r gvd && useradd -r -g gvd gvd

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder --chown=gvd:gvd /root/.local /home/gvd/.local

# Set Python path
ENV PATH=/home/gvd/.local/bin:$PATH
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Copy CLI code
COPY --chown=gvd:gvd . .

# Create necessary directories with proper permissions
RUN mkdir -p \
    /app/reports \
    /app/repos \
    /app/temp \
    /app/logs \
    && chown -R gvd:gvd \
    /app/reports \
    /app/repos \
    /app/temp \
    /app/logs \
    && chmod 755 /app/reports /app/repos /app/temp /app/logs

# Switch to non-root user
USER gvd

# Health check for CLI container
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Default command - can be overridden
CMD ["python", "cli.py", "help"]
